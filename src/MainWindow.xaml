<Window x:Class="DshBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DshBar"
        Icon="/Assets/whale.ico"
        Width="1180" Height="780"
        MinWidth="720" MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ChromeBgBrush}"
        Topmost="False"
        ShowInTaskbar="True">
    <!-- 干净的边框效果：无玻璃框、无标题栏占位，保留 6px 调整边框和阴影 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            CornerRadius="0"
                            CaptionHeight="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource ChromeBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 托盘图标：鲸鱼图标 + 右键菜单 -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Assets/whale.ico"
                        ToolTipText="DshBar"
                        TrayMouseDoubleClick="TrayIcon_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                    <MenuItem x:Name="TrayToggleItem"
                              Header="显示 / 隐藏"
                              Style="{StaticResource ModernMenuItemStyle}"
                              Click="TrayToggle_Click"/>
                    <MenuItem x:Name="TrayRestartItem"
                              Header="重启服务"
                              Style="{StaticResource ModernMenuItemStyle}"
                              Click="RestartService_Click"/>
                    <MenuItem x:Name="TrayUpdateItem"
                              Header="检查更新"
                              Style="{StaticResource ModernMenuItemStyle}"
                              Click="CheckUpdate_Click"/>
                    <MenuItem x:Name="AutoStartItem"
                              Header="开机自启动"
                              Style="{StaticResource ModernMenuItemStyle}"
                              IsCheckable="True"
                              Click="AutoStartItem_Click"/>
                    <Separator Style="{StaticResource ModernSeparatorStyle}"/>
                    <MenuItem x:Name="TrayQuitItem"
                              Header="退出"
                              Style="{StaticResource ModernMenuItemStyle}"
                              Click="TrayQuit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- 自绘标题栏：与 GUI 左侧边栏同色（sidebar-fill 深色 = rgb(27,27,28)）；
             拖动移动窗口；— 隐藏回后台；✕ 退出程序 -->
        <Grid Grid.Row="0" Background="{DynamicResource ChromeBgBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左上角：鲸鱼图标（单击弹菜单）+ 右下角服务状态点 -->
            <Grid x:Name="WhaleArea"
                  Grid.Column="0"
                  Width="34" Height="34"
                  Margin="10,0,0,0"
                  HorizontalAlignment="Left"
                  Background="Transparent"
                  Cursor="Hand"
                  ToolTip="菜单"
                  MouseLeftButtonDown="WhaleArea_MouseLeftButtonDown">
                <Grid.ContextMenu>
                    <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                        <MenuItem x:Name="WinToggleItem"
                                  Header="显示 / 隐藏"
                                  Style="{StaticResource ModernMenuItemStyle}"
                                  Click="TrayToggle_Click"/>
                        <MenuItem x:Name="WinRestartItem"
                                  Header="重启服务"
                                  Style="{StaticResource ModernMenuItemStyle}"
                                  Click="RestartService_Click"/>
                        <MenuItem x:Name="WinUpdateItem"
                                  Header="检查更新"
                                  Style="{StaticResource ModernMenuItemStyle}"
                                  Click="CheckUpdate_Click"/>
                        <MenuItem x:Name="WindowAutoStartItem"
                                  Header="开机自启动"
                                  Style="{StaticResource ModernMenuItemStyle}"
                                  IsCheckable="True"
                                  Click="AutoStartItem_Click"/>
                        <Separator Style="{StaticResource ModernSeparatorStyle}"/>
                        <MenuItem x:Name="WinQuitItem"
                                  Header="退出"
                                  Style="{StaticResource ModernMenuItemStyle}"
                                  Click="TrayQuit_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Image Source="/Assets/whale.ico"
                       Width="18" Height="18"
                       VerticalAlignment="Center"/>
                <Ellipse x:Name="StatusDot"
                         Width="8" Height="8"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,2,3"
                         Fill="#FF5A5A60"
                         Stroke="{DynamicResource ChromeBgBrush}"
                         StrokeThickness="1.5"/>
            </Grid>

            <Button Grid.Column="1"
                    Content="✕"
                    Style="{StaticResource TitleBarButtonStyle}"
                    FontSize="13"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseToTray_Click"/>
        </Grid>

        <!-- 内容区：加载页与 WebView2 叠放；内收 5px 给边缘调整热区让位
             （WebView2 是独立 HWND，会盖住 WPF 命中区，所以热区必须是纯 WPF 地带） -->
        <Grid Grid.Row="1" Margin="5,0,5,5">
            <wv2:WebView2 x:Name="WebView" Visibility="Collapsed"/>

            <StackPanel x:Name="LoadingPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <ProgressBar Width="220" Height="4"
                             IsIndeterminate="True"
                             Foreground="#FF3B82F6"
                             Background="{DynamicResource ProgressTrackBrush}"
                             BorderThickness="0"/>
                <TextBlock x:Name="StatusText"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13"
                           Text="正在准备…"/>
                <TextBlock x:Name="ErrorText"
                           Margin="0,10,0,0"
                           MaxWidth="640"
                           TextWrapping="Wrap"
                           Foreground="#FFF87171"
                           FontSize="12"
                           Visibility="Collapsed"/>
                <Button x:Name="RetryButton"
                        Content="重试"
                        Margin="0,14,0,0"
                        Padding="18,6"
                        HorizontalAlignment="Center"
                        Background="#FF3B82F6"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="RetryButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- 边缘/四角调整尺寸热区：透明但可命中，Tag 携带 NCHITTEST 代码 -->
        <Border Grid.RowSpan="2" Tag="12" Cursor="SizeNS"
                Height="5" VerticalAlignment="Top"
                Background="Transparent"
                MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Border Grid.RowSpan="2" Tag="15" Cursor="SizeNS"
                Height="5" VerticalAlignment="Bottom"
                Background="Transparent"
                MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Border Grid.RowSpan="2" Tag="10" Cursor="SizeWE"
                Width="5" HorizontalAlignment="Left"
                Background="Transparent"
                MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Border Grid.RowSpan="2" Tag="11" Cursor="SizeWE"
                Width="5" HorizontalAlignment="Right"
                Background="Transparent"
                MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Border Grid.RowSpan="2" Tag="13" Cursor="SizeNWSE"
                Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent"
                MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Border Grid.RowSpan="2" Tag="14" Cursor="SizeNESW"
                Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent"
                MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Border Grid.RowSpan="2" Tag="16" Cursor="SizeNESW"
                Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="Transparent"
                MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Border Grid.RowSpan="2" Tag="17" Cursor="SizeNWSE"
                Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent"
                MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
    </Grid>
</Window>
